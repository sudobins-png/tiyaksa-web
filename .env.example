TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. http://user:pass@host:port or http://host:port — routes the
# Telegram API calls through an HTTP proxy. Needed in production because the
# VPS's network blocks outbound to Telegram's IP range directly; leave unset
# for local dev.
TELEGRAM_PROXY_URL=

# AI assistant (floating chat widget). Without ANTHROPIC_API_KEY the widget
# stays hidden and /api/assistant answers "not configured".
ANTHROPIC_API_KEY=
# HTTP proxy for api.anthropic.com — same reason as TELEGRAM_PROXY_URL: the
# production VPS can't reach Anthropic directly. Leave unset for local dev.
ANTHROPIC_PROXY_URL=
# Optional. Defaults to claude-opus-5-5; claude-sonnet-5-5 / claude-haiku-5-5 cost less.
ASSISTANT_MODEL=
# Optional. Messages per day across all visitors (default 400); the widget hides itself past it.
ASSISTANT_DAILY_LIMIT=
